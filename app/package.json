{
  "name": "antidrug-paper-theater",
  "private": true,
  "version": "0.1.0",
  "description": "反毒剪紙劇場：劇場程式（three.js WebGLRenderer，打包成傳統 script，file:// 可跑）",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "serve": "node ../tools/serve.mjs dist 8787",
    "pack": "node ../tools/pack.mjs",
    "test:engine": "node ../tools/engine-test.mjs",
    "capture": "node ../tools/capture.mjs --cues demo --out ../review/_capture_test"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
