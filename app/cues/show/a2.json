    {
     "id": "a2_c012_01",
     "speaker": "葉護理師",
     "text": "阿樂，你哪裡不舒服？我陪你去看醫生，好嗎？"
    },
    {
     "id": "a2_c012_02",
     "speaker": "阿樂叔叔",
     "text": "不用……我休息一下就好。",
     "start": "a2_c012_01.end+0.45"
    },
    {
     "id": "a2_c012_03",
     "speaker": "葉護理師",
     "text": "你家人的電話沒人接，我晚一點再打。",
     "start": "a2_c012_02.end+2.3"
    },
    {
     "id": "a2_c012_04",
     "speaker": "小晴",
     "text": "還有，廣場上有人拿閃亮的盒子給小孩。",
     "start": "a2_c012_03.end+0.45"
    },
    {
     "id": "a2_c012_05",
     "speaker": "葉護理師",
     "text": "謝謝你們告訴我，我會請警察去看看。",
     "start": "a2_c012_04.end+0.45"
    }
   ],
