   "lines": [
    {
     "id": "a5_c001_01",
     "speaker": "小晴",
     "text": "主燈骨架！原來在叔叔車上！",
     "start": 0.95
    },
    {
     "id": "a5_c001_02",
     "speaker": "陳伯伯",
     "text": "阿樂，你坐著。林老師，我去轉角帶小朋友過馬路，很快回來！",
     "start": "a5_c001_01.end+1.4"
    },
    {
     "id": "a5_c001_03",
     "speaker": "林老師",
     "text": "好，我馬上出來！",
     "start": "a5_c001_02.end+0.3"
    },
    {
     "id": "a5_c001_04",
     "speaker": "小宇",
     "text": "阿樂叔叔？阿樂叔叔！",
     "start": "a5_c001_03.end+11.25"
    },
    {
     "id": "a5_c001_05",
     "speaker": "小晴",
     "text": "他……叫不醒。",
     "start": "a5_c001_04.end+0.4"
    },
    {
     "id": "a5_c001_06",
     "speaker": "折折",
     "text": "陳伯伯在轉角，林老師在辦公室。他們該怎麼做？",
     "start": "a5_c001_05.end+0.4"
    }
   ],
