   "lines": [
    {
     "id": "a0_c004_01",
     "speaker": "小宇",
     "text": "阿樂叔叔早！折折早！"
    },
    {
     "id": "a0_c004_02",
     "speaker": "小晴",
     "text": "骨架不見了？我記下來。"
    },
    {
     "id": "a0_c004_03",
     "speaker": "折折",
     "text": "交給我！我摺成放大鏡，馬上找到！",
     "skippableWhenBehind": true,
     "start": "a0_c004_02.end+2.00"
    },
    {
     "id": "a0_c004_04",
     "speaker": "小宇",
     "text": "呃……謝謝，我剛好缺一頂帽子。",
     "skippableWhenBehind": true
    },
    {
     "id": "a0_c004_05",
     "speaker": "阿樂叔叔",
     "text": "你們先去上學。放學再來幫叔叔找，好不好？"
    },
    {
     "id": "a0_c004_06",
     "speaker": "小晴、小宇",
     "text": "好！"
    }
   ],
