   "lines": [
    {
     "id": "a1_c004_01",
     "speaker": "邀請者",
     "text": "這是電子煙啦，大家都在玩。試試看嘛。"
    },
    {
     "id": "a1_c004_02",
     "speaker": "小晴",
     "text": "電子煙在臺灣是禁止的。"
    },
    {
     "id": "a1_c004_03",
     "speaker": "小晴",
     "text": "包裝漂亮、聞起來香，都不能證明安全。"
    },
    {
     "id": "a1_c004_04",
     "speaker": "小宇",
     "text": "不用，我們不要。"
    },
    {
     "id": "a1_c004_05",
     "speaker": "小晴",
     "text": "品安，快來，我們去跟阿樂叔叔說。",
     "start": "a1_c004_04.end+3.30"
    },
    {
     "id": "a1_c004_06",
     "speaker": "品安",
     "text": "你們先走，我把燈籠收好就來。"
    }
   ],
