{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "antidrug-cues/1",
  "title": "反毒剪紙劇場 cue 檔",
  "description": "與 app/src/types/cue.ts 描述同一個結構（G4 後凍結；G5 全劇欄位 2026-10-21 由主線授權加入）；執行期與打包期都會用 app/src/cues/validate.ts 驗證。全劇放在 app/cues/show/：index.json（definitions.showIndex）＋各段落檔（本結構）。",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "cues"
  ],
  "properties": {
    "format": {
      "const": "antidrug-cues/1"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "characters": {
      "description": "角色名冊：角色 id → { name 顯示名稱, rig 紙偶種類（adult／child／ale_v03／standee:<角色>／zhezhe／assets/final/rig/show_characters.json 的 rigs）, x, z, facing 預設站位, fallback 佔位紙偶 }",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "rig": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "facing": {
            "enum": [
              1,
              -1
            ]
          },
          "fallback": {
            "enum": [
              "adult",
              "child"
            ],
            "description": "rig 找不到時的程式佔位紙偶"
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/cue"
      }
    },
    "set": {
      "type": "string",
      "description": "舞台景（檔案層級；cue 可再覆寫）：workshop（技術骨架佔位景）／workshop_g4（G4 燈籠店立體書景）／kraft_stage（全劇牛皮紙佔位景）／app/src/sets/registry.ts 登記的景／assets/final/sets/<景名>/layout.json 的資料驅動景"
    },
    "segments": {
      "type": "array",
      "description": "全劇合併後才有（tools/pack.mjs 產生）：各段落的 id、標題、檔名、景、名冊與 cue 清單；作者不用寫",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "file",
          "cueIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "set": {
            "type": "string"
          },
          "characters": {
            "type": "object"
          },
          "cueIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "timeRef": {
      "description": "秒數，或 \"台詞編號\"、\"台詞編號.end\"、\"end\"，可加 +秒／-秒",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^([a-z0-9_]+?)(\\.end|\\.start)?([+-]\\d+(\\.\\d+)?)?$"
        }
      ]
    },
    "line": {
      "type": "object",
      "required": [
        "id",
        "speaker",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a\\d_c\\d{3}_\\d{2}$",
          "description": "台詞編號 a{幕}_c{三位數}_{兩位數}"
        },
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "字幕文字，與配音逐字相同"
        },
        "audioId": {
          "type": "string",
          "description": "省略時為 vo_<台詞編號>（audio/vo/vo_<台詞編號>_vNN.wav）"
        },
        "start": {
          "$ref": "#/definitions/timeRef",
          "description": "字幕時間點"
        },
        "lipsyncId": {
          "type": "string",
          "description": "對嘴資料 id，省略時同台詞編號"
        },
        "skippableWhenBehind": {
          "type": "boolean"
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "name",
        "start"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "動畫名稱：舞台層見 src/engine/world.ts（G5 新增 set.swap {set}、fade.out {to}、fade.in），角色見 src/stage/perform.ts；程式角色可用 <程式名>.<動作>（例如 zhezhe.fold）"
        },
        "target": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/timeRef"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "ease": {
          "enum": [
            "linear",
            "in",
            "out",
            "inOut",
            "sine",
            "heavy"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "characterStart": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "facing": {
          "enum": [
            1,
            -1
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "pose": {
          "type": "string"
        },
        "strings": {
          "type": "array",
          "items": {
            "enum": [
              "wrist",
              "elbow",
              "knee"
            ]
          }
        },
        "stringTension": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "popup": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0＝平躺等待隨景片立起"
        },
        "sit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "坐姿程度：1 坐、0.5 半站、0 站"
        },
        "emotion": {
          "enum": [
            "smile",
            "greet",
            "neutral",
            "confused",
            "worried",
            "surprised"
          ]
        },
        "hand": {
          "enum": [
            "chest",
            "grab",
            "lap"
          ]
        }
      }
    },
    "quiz": {
      "type": "object",
      "required": [
        "qid",
        "number",
        "question",
        "options",
        "answer"
      ],
      "properties": {
        "qid": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "cue": {
      "type": "object",
      "required": [
        "id",
        "sceneId",
        "kind",
        "initialState",
        "animation",
        "audioId",
        "lines",
        "next",
        "prevStable",
        "skippable",
        "compression",
        "fx",
        "teacherNote",
        "checkpoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a\\d_c\\d{3}$",
          "description": "cue 編號 a{幕}_c{三位數}"
        },
        "sceneId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "title",
            "curtain",
            "scene",
            "quiz",
            "reveal",
            "wait",
            "lamp"
          ],
          "description": "種類"
        },
        "title": {
          "type": "string"
        },
        "initialState": {
          "description": "角色起始狀態（含舞台狀態）",
          "type": "object",
          "properties": {
            "stage": {
              "type": "object",
              "properties": {
                "curtain": {
                  "enum": [
                    "open",
                    "closed"
                  ]
                },
                "titleCard": {
                  "type": "boolean"
                },
                "camera": {
                  "type": "string"
                },
                "light": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "quiz": {
                  "type": "boolean"
                },
                "set": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "立體書景片 0 平躺、1 立好"
                },
                "desat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "FX8 降彩"
                },
                "spot": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "FX4 追光"
                },
                "spotTarget": {
                  "type": "string"
                }
              }
            },
            "characters": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/characterStart"
              }
            }
          }
        },
        "animation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/animation"
          }
        },
        "audioId": {
          "type": [
            "string",
            "null"
          ],
          "description": "段落配樂／環境音；null＝沿用；\"none\"＝停止"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/line"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "description": "下一節點"
        },
        "prevStable": {
          "type": [
            "string",
            "null"
          ],
          "description": "上一穩定節點"
        },
        "skippable": {
          "type": "boolean",
          "description": "是否可略過"
        },
        "compression": {
          "enum": [
            0,
            1,
            2
          ],
          "description": "壓縮級別"
        },
        "fx": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FX\\d+$"
          },
          "description": "特效編號"
        },
        "teacherNote": {
          "type": "string",
          "description": "教師提示"
        },
        "checkpoint": {
          "description": "查核點",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "label",
                "atMinute"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "atMinute": {
                  "type": "number"
                },
                "escalate": {
                  "type": "object",
                  "required": [
                    "behindSec",
                    "level"
                  ],
                  "properties": {
                    "behindSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "level": {
                      "enum": [
                        1,
                        2
                      ]
                    }
                  },
                  "description": "落後 ≥ behindSec 秒時建議啟用 level 級壓縮"
                }
              }
            }
          ]
        },
        "minDuration": {
          "type": "number",
          "minimum": 0
        },
        "voStart": {
          "type": "number",
          "minimum": 0
        },
        "tail": {
          "type": "number",
          "minimum": 0
        },
        "autoAdvance": {
          "type": "boolean"
        },
        "quiz": {
          "$ref": "#/definitions/quiz"
        },
        "lamp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "at": {
                "$ref": "#/definitions/timeRef"
              },
              "gain": {
                "type": "number"
              }
            }
          }
        },
        "shortVersion": {
          "type": "string"
        },
        "music": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/musicEvent"
          },
          "description": "段落內的配樂切換（交叉淡入淡出）"
        },
        "musicLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "musicLoop": {
          "type": "boolean"
        },
        "set": {
          "type": "string",
          "description": "這個 cue 的景（覆寫檔案層級）"
        },
        "setFade": {
          "type": "number",
          "minimum": 0.6,
          "description": "換景（或刻意從暗開始）時的亮度漸變秒數，最少 0.6；景不同時自動套用 0.8"
        },
        "level1": {
          "$ref": "#/definitions/cueVariant",
          "description": "壓縮級別 1 的替代版本"
        },
        "level2": {
          "$ref": "#/definitions/cueVariant",
          "description": "壓縮級別 2 的替代版本（短版）"
        },
        "storyboard": {
          "type": "object",
          "description": "動態分鏡底稿（劇本舞台指示＋節拍表），引擎不讀",
          "properties": {
            "beat": {
              "type": "string"
            },
            "cast": {
              "type": "string"
            },
            "camera": {
              "type": "string"
            },
            "sound": {
              "type": "string"
            },
            "directions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "estimateSec": {
              "type": "number"
            },
            "actionSec": {
              "type": "number"
            }
          }
        },
        "segment": {
          "type": "string",
          "description": "所屬段落（合併時填入，作者不用寫）"
        }
      }
    },
    "musicEvent": {
      "type": "object",
      "required": [
        "id",
        "at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "$ref": "#/definitions/timeRef"
        },
        "loop": {
          "type": "boolean"
        },
        "fade": {
          "type": "number",
          "minimum": 0
        },
        "gain": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cueVariant": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^a\\d_c\\d{3}_\\d{2}$"
          },
          "description": "只留這些台詞"
        },
        "animation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/animation"
          }
        },
        "minDuration": {
          "type": "number",
          "minimum": 0
        },
        "voStart": {
          "type": "number",
          "minimum": 0
        },
        "tail": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "showIndex": {
      "type": "object",
      "description": "app/cues/show/index.json：全劇段落清單（依演出順序）",
      "required": [
        "format",
        "id",
        "title",
        "segments"
      ],
      "properties": {
        "format": {
          "const": "antidrug-show/1"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.json$"
          }
        }
      }
    }
  }
}
