  {
   "id": "a5_c006",
   "kind": "scene",
   "title": "撥 119",
   "duration": 31.18,
   "autoAdvance": false,
   "set": "a5_gate",
   "enterFade": 0,
   "audioId": null,
   "musicLoop": true,
   "musicLevel": 0.5,
   "compression": 0,
   "lamp": null,
   "quiz": null,
   "lines": [
    {
     "id": "a5_c006_01",
     "speaker": "執勤人員",
     "text": "119 您好，請問發生什麼事？在哪裡？",
     "audioId": "vo_a5_c006_01",
     "start": 1.4,
     "end": 6.55,
     "duration": 5.15,
     "placeholder": false,
     "pages": [
      {
       "start": 1.4,
       "end": 6.55,
       "rows": [
        "119 您好，請問發生什麼事？",
        "在哪裡？"
       ]
      }
     ]
    },
    {
     "id": "a5_c006_02",
     "speaker": "小宇",
     "text": "這裡是小燈國小正門口。有一個大人坐在門口的椅子上，叫不醒。",
     "audioId": "vo_a5_c006_02",
     "start": 6.8,
     "end": 13.72,
     "duration": 6.92,
     "placeholder": false,
     "pages": [
      {
       "start": 6.8,
       "end": 13.72,
       "rows": [
        "這裡是小燈國小正門口。有一個",
        "大人坐在門口的椅子上，叫不醒。"
       ]
      }
     ]
    },
    {
     "id": "a5_c006_03",
     "speaker": "執勤人員",
     "text": "好，我們會派救護車過去。你現在安全嗎？旁邊有大人嗎？",
     "audioId": "vo_a5_c006_03",
     "start": 13.97,
     "end": 20.79,
     "duration": 6.82,
     "placeholder": false,
     "pages": [
      {
       "start": 13.97,
       "end": 20.79,
       "rows": [
        "好，我們會派救護車過去。",
        "你現在安全嗎？旁邊有大人嗎？"
       ]
      }
     ]
    },
    {
     "id": "a5_c006_04",
     "speaker": "小宇",
     "text": "我在校門裡面。我同學去找老師了。",
     "audioId": "vo_a5_c006_04",
     "start": 21.04,
     "end": 25.1,
     "duration": 4.06,
     "placeholder": false,
     "pages": [
      {
       "start": 21.04,
       "end": 25.1,
       "rows": [
        "我在校門裡面。我同學去找老師了。"
       ]
      }
     ]
    },
    {
     "id": "a5_c006_05",
     "speaker": "執勤人員",
     "text": "做得很好。待在安全的地方，聽我的指示。",
     "audioId": "vo_a5_c006_05",
     "start": 25.35,
     "end": 30.33,
     "duration": 4.98,
     "placeholder": false,
     "pages": [
      {
       "start": 25.35,
       "end": 30.33,
       "rows": [
        "做得很好。",
        "待在安全的地方，聽我的指示。"
       ]
      }
     ]
    }
