   "lines": [
    {
     "id": "a0_c004_01",
     "speaker": "小宇",
     "text": "阿樂叔叔早！折折早！",
     "audioId": "vo_a0_c004_01",
     "start": 3.35,
     "end": 6.06,
     "duration": 2.71,
     "placeholder": false,
     "pages": [
      {
       "start": 3.35,
       "end": 6.06,
       "rows": [
        "阿樂叔叔早！折折早！"
       ]
      }
     ]
    },
    {
     "id": "a0_c004_02",
     "speaker": "小晴",
     "text": "骨架不見了？我記下來。",
     "audioId": "vo_a0_c004_02",
     "start": 6.51,
     "end": 9.71,
     "duration": 3.2,
     "placeholder": false,
     "pages": [
      {
       "start": 6.51,
       "end": 9.71,
       "rows": [
        "骨架不見了？我記下來。"
       ]
      }
     ]
    },
    {
     "id": "a0_c004_03",
     "speaker": "折折",
     "text": "交給我！我摺成放大鏡，馬上找到！",
     "audioId": "vo_a0_c004_03",
     "start": 11.71,
     "end": 15.58,
     "duration": 3.87,
     "placeholder": false,
     "pages": [
      {
       "start": 11.71,
       "end": 15.58,
       "rows": [
        "交給我！我摺成放大鏡，馬上找到！"
       ]
      }
     ]
    },
    {
     "id": "a0_c004_04",
     "speaker": "小宇",
     "text": "呃……謝謝，我剛好缺一頂帽子。",
     "audioId": "vo_a0_c004_04",
     "start": 16.03,
     "end": 19.37,
     "duration": 3.34,
     "placeholder": false,
     "pages": [
      {
       "start": 16.03,
       "end": 19.37,
       "rows": [
        "呃……謝謝，我剛好缺一頂帽子。"
       ]
      }
     ]
    },
    {
     "id": "a0_c004_05",
     "speaker": "阿樂叔叔",
     "text": "你們先去上學。放學再來幫叔叔找，好不好？",
     "audioId": "vo_a0_c004_05",
     "start": 19.82,
     "end": 25.51,
     "duration": 5.69,
     "placeholder": false,
     "pages": [
      {
       "start": 19.82,
       "end": 25.51,
       "rows": [
