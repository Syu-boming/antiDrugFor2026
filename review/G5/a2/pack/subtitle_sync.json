   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c004_01_v04.wav"
  },
  {
   "cue": "a2_c004",
   "line": "a2_c004_02",
   "page": 1,
   "text": "這些線是故事的比喻。",
   "subtitle_start_s": 6.46,
   "voice_start_s": 6.58,
   "diff_s": -0.12,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c004_02_v04.wav"
  },
  {
   "cue": "a2_c004",
   "line": "a2_c004_02",
   "page": 2,
   "text": "毒品可能讓人的頭腦／和身體受到影響，不聽使喚。",
