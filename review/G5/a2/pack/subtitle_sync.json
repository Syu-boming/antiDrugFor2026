   "voice_start_s": 10.984,
   "diff_s": 0.051,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c003_02_v04.wav"
  },
  {
   "cue": "a2_c004",
   "line": "a2_c004_01",
   "page": 1,
