   "voice_start_s": 10.065,
   "diff_s": -0.403,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c004_02_v04.wav"
  },
  {
   "cue": "a2_c004",
