   "subtitle_start_s": 16.708,
   "voice_start_s": 16.976,
   "diff_s": -0.268,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c004_02_v04.wav"
  },
  {
   "cue": "a2_c005",
   "line": "a2_c005_01",
   "page": 1,
   "text": "第二題！",
   "subtitle_start_s": 1.4,
   "voice_start_s": 1.525,
   "diff_s": -0.125,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c005_01_v04.wav"
  },
  {
   "cue": "a2_c005",
   "line": "a2_c005_02",
   "page": 1,
   "text": "阿樂叔叔身上的操偶線，／在比喻什麼？",
   "subtitle_start_s": 4,
   "voice_start_s": 4.126,
   "diff_s": -0.126,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c005_02_v04.wav"
  },
  {
   "cue": "a2_c005",
   "line": "a2_c005_03",
   "page": 1,
   "text": "一，叔叔在練習下／一場紙偶戲的動作。",
   "subtitle_start_s": 8.41,
   "voice_start_s": 8.54,
   "diff_s": -0.13,
   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a2_c005_03_v04.wav"
  },
