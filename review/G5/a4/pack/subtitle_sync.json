   "pass": true,
   "detect": "-40 dB／0.05 s",
   "audio": "audio/vo/vo_a4_c002_02_v04.wav"
  },
  {
   "cue": "a4_c002",
   "line": "a4_c002_03",
   "page": 1,
   "text": "等一下！我們先把故事暫停，／用紙上的路想一想。",
   "subtitle_start_s": 8.18,
   "voice_start_s": 8.309,
   "diff_s": -0.129,
