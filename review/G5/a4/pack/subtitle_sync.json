  {
   "cue": "a4_c001",
   "line": "a4_c001_02",
   "page": 1,
   "text": "小晴、小宇……走吧，／叔叔載你們去廣場。",
   "subtitle_start_s": 15.41,
   "voice_start_s": 15.536,
   "diff_s": -0.126,
